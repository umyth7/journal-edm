{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=edm_journal;Username=postgres;Password=postgres",
    "Hangfire": "Host=localhost;Port=5432;Database=edm_journal;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AdminOrigin": "http://localhost:3000"
  },
